# ========================================================
# OmniAqua - .gitignore
# ========================================================

# Dependências Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Variáveis de Ambiente e Segredos
.env
.env.local
.env.*.local
*.pem
*.key

# Credenciais do Firmware (mantém config.example.h, ignora config.h com Wi-Fi/senhas reais)
firmware/**/config.h
*.secrets.h

# Compilação Arduino / PlatformIO
.pio/
.pioenvs/
.piolibdeps/
*.hex
*.bin
*.elf
*.o
*.a

# Docker e Volumes Locais
pgdata/
mosquitto/data/
mosquitto/log/

# IDEs e Editores
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.history/
*.suo
*.user

# Arquivos do Sistema Operacional
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

